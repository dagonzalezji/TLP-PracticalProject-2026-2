# snake_evolved.brick
# BrickScript Snake Multinivel - Actividad 4: Evolucion del Lenguaje y Logica de Niveles
GAME_TYPE SNAKE

GAME_GRID (18, 18)

# --- Bloque de Configuracion de Niveles de Dificultad ---
LEVELS:
  LEVEL BABY:
    TICK_SPEED: 0.15
    SCORE_THRESHOLD: 0
  END
  LEVEL ENTUSIASTA:
    TICK_SPEED: 0.10
    POWERUP_DURATION: 6
    SCORE_THRESHOLD: 30
    POISON_PENALTY: 10
  END
  LEVEL NYAN_CAT:
    TICK_SPEED: 0.05
    POWERUP_DURATION: 6
    OBSTACLES: 3
    SCORE_THRESHOLD: 80
    POISON_PENALTY: 20
  END
END

# --- Definicion Geometrica de Formas y Entidades ---
DEFINE SHAPE SNAKE_BODY:
  TYPE: CIRCULAR
  COLOR: #00E676
  STATE 1:
    [1]
END

DEFINE SHAPE SNAKE_HEAD:
  TYPE: CIRCULAR
  COLOR: #00B0FF
  STATE 1:
    [1]
END

DEFINE SHAPE FOOD:
  TYPE: CIRCULAR
  COLOR: #FF1744
  STATE 1:
    [1]
END

DEFINE SHAPE POISON_FOOD:
  TYPE: TRIANGULAR
  COLOR: #D500F9
  STATE 1:
    [1]
END

DEFINE SHAPE POWERUP_FOOD:
  TYPE: CIRCULAR
  COLOR: #FFD600
  DURATION: 6
  STATE 1:
    [1]
END

DEFINE SHAPE CLOUD_OBSTACLE:
  TYPE: CIRCULAR
  COLOR: #81D4FA
  STATE 1:
    [1]
END

# --- Logica y Reglas del Juego ---
ON START:
  SPAWN PLAYER AT (9, 9)
  SPAWN FOOD AT RANDOM
END

ON TICK:
  MOVE PLAYER FORWARD
END

ON EAT_FOOD:
  INCREASE_SCORE 10
  GROW PLAYER 1
  SPAWN FOOD AT RANDOM
END

ON COLLISION_WALL:
  GAME_OVER
END

ON COLLISION_SELF:
  GAME_OVER
END

# --- Controles ---
ON KEY_UP:
  SET_DIRECTION UP
END
ON KEY_DOWN:
  SET_DIRECTION DOWN
END
ON KEY_LEFT:
  SET_DIRECTION LEFT
END
ON KEY_RIGHT:
  SET_DIRECTION RIGHT
END
